# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
*.egg-info/
.venv/
venv/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Claude Code worktrees / local agent state
.claude/worktrees/
.claude/settings.local.json

# Secrets — never commit credentials (MCP servers read these from the environment)
.env
.env.*
*.local

# Generated/output artifacts (skills write into the user's workspace, not here)
/tmp/
*.log
# seo-drift's default SQLite baseline store, created in the working directory
.seo-drift/

# Internal process docs — kept locally, not shipped in the public plugin
docs/

# Clean-room denylist — real client/brand names kept local, never shipped
.clean-room-denylist

# Clean-room third-party guard — inspiration on-disk counts/column schemas +
# name/marker denylist + owner-tool allowlist; literals stay local, never shipped
.cleanroom-thirdparty
